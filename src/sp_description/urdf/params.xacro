<?xml version="1.0"?>
<!--
  모바일 로봇 치수 파라미터.

  출처: 도면 `모바일 로봇 ASSY.stp` (6안 ASSY_충남대 송부용, 2026-08-14, Inventor 2025)
  치수는 `step_to_robot.py` 가 STEP 에서 직접 뽑은 실측이다.
  **질량·관성·IMU 는 여전히 가정치**다 (각 절의 ⚠ 참조).

  좌표계: X = 주행 방향(론지 방향), z=0 은 **바퀴부 접지면**(= 론지 플랜지 상면),
          조립체 XY 중심이 원점.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ═══ 기계 구성 ═══

       X   -2.05        -1.02   -0.88    +0.88   +1.02        +2.05
           │◀── 후단부 ──▶│      │◀ 바퀴부 ▶│      │◀── 전단부 ──▶│
             무한궤도 + 회전부                       무한궤도 + 회전부
             ↓ 바닥에 닿는다                         ↓ 바닥에 닿는다
       ───────────────── 상판 4.10 m ─────────────────
                  + HSR25 리니어축 + 캐리지 + CRX-20iA/L

       · 가운데 **바퀴부**가 론지 위에 얹혀 론지를 따라 X 로만 주행한다.
       · 양 **끝단부**는 론지가 아니라 **바닥**에 닿는다. 각각 상하·회전 축을 갖는다.
       · 바퀴부 위 **상판**도 상하·회전 축을 갖는다.

       론지 상면과 바닥은 450 mm 차이다. 끝단부 상하 스트로크가 그만큼 필요하다. -->

  <!-- ═══ 론지와의 관계 ═══
       바퀴부는 **인접한 두 론지에 양쪽 바퀴를 하나씩 걸치고** 달린다.
       그래서 **구동륜 궤간 = 론지 pitch = 845 mm** 로 고정된다 — 동정할 여지가 없다.
       끝단부는 그 두 론지 **사이 통로(695 mm)의 바닥**에 내려앉는다.

           ←─ 845 (론지 pitch = 궤간) ─→
        ══O══                        ══O══     ← 구동륜, 론지 플랜지 위 (z 0.520)
         ███        [끝단부 궤도]       ███      ← 론지 (높이 450, 플랜지 150)
         ███   ←── 통로 695 ──→        ███
        ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━     ← 바닥판 (z 0.070)

       ⚠ **도면의 바퀴 부분은 그대로 쓰지 않았다.** 도면 바퀴부 체인은 폭 32.4 mm
         두 줄에 궤간 421.5 mm 라 론지 플랜지(150 mm)에 얹히지 않고, 통로(695 mm)
         안에서 허공에 뜬다. 그래서 **체인은 메시에서 빼고 궤간 845 mm 짜리 바퀴
         여러 개로 갈아끼웠다** (오도메트리 데이터를 쓰기 위해서이기도 하다).
         차체·끝단부·상판의 **실치수는 도면 그대로** 유지한다.
         바퀴 높이(축 z=0.0689, 반경 0.0609)도 도면 스프라켓 값을 그대로 써서
         상판 높이 등 수직 치수가 도면과 어긋나지 않게 했다. -->

  <!-- 블록 도면 실측. 궤간이 여기 묶인다. -->
  <xacro:property name="longi_pitch"        value="0.845"/>
  <xacro:property name="longi_flange_width" value="0.150"/>

  <!-- ═══ 전체 ═══ -->
  <xacro:property name="overall_length" value="4.100"/>
  <xacro:property name="overall_width"  value="0.543"/>   <!-- 끝단 궤도 바깥 -->
  <!-- ⚠ 0.841 은 **도면 팔 덩어리** 기준이다. 팔을 6축으로 세운 뒤로는
       접은 자세에서 z 1.052 까지 올라간다 (CRX 숄더가 캐리지 상면 0.676 위
       0.23 m 에 있어서 구조적으로 그렇다). 도면값은 치수 기록으로 남겨 둔다. -->
  <xacro:property name="overall_height" value="0.841"/>   <!-- 도면 팔 덩어리 기준 -->

  <!-- ═══ 바퀴부 (base_link) — 론지 위 주행 ═══
       메시 좌표(z=0 = 도면 공통 접지면) 기준 값들. -->
  <xacro:property name="wheel_unit_x"   value="0.826"/>   <!-- ±X (체인 제외 차체) -->
  <xacro:property name="wheel_unit_y"   value="0.250"/>   <!-- ±Y -->
  <xacro:property name="wheel_unit_z0"  value="0.008"/>   <!-- 접지면 = 축 - 반경 -->
  <xacro:property name="wheel_unit_body_z0" value="0.029"/>  <!-- 차체 하면 -->
  <xacro:property name="wheel_unit_z1"  value="0.454"/>   <!-- 상단 -->
  <xacro:property name="axle_z"         value="0.0689"/>  <!-- 스프라켓 축 높이 -->
  <xacro:property name="wheel_radius"   value="${axle_z - wheel_unit_z0}"/>  <!-- 0.0609 -->

  <!-- 참고: 도면 체인은 폭 32.4 mm / 궤간 421.5 mm 였다 (쓰지 않는다) -->
  <xacro:property name="chain_gauge"    value="0.4215"/>
  <xacro:property name="chain_width"    value="0.0324"/>

  <!-- ═══ 구동륜 — 론지 위 ═══
       궤간은 **론지 pitch 에 고정**. 폭은 플랜지(150) 안에 들어가야 한다. -->
  <xacro:property name="drive_gauge"    value="${longi_pitch}"/>   <!-- 0.845 -->
  <xacro:property name="drive_width"    value="0.120"/>            <!-- 여유 각 15 mm -->
  <!-- ⚠ **반경은 건드리지 않는다.** axle_z(0.0689) - wheel_radius = 접지면(0.008) 이
       도면의 수직 스택을 그대로 물고 있고, 같은 값이 `wheel_odom` 의 구름반경
       파라미터이자 DiffDrive 의 wheel_radius 다. 반경을 바꾸면 로봇이 앉는 높이,
       스폰 z, 오도메트리 스케일이 한꺼번에 어긋난다 (docs/localization.md 의 "gz /odom 과 35 μm
       차이" 검증도 무효가 된다).
       그래서 "바퀴부 길이에 맞춘다"는 **개수와 피치**로 푼다 — 바퀴부 몸통 ±0.826
       안쪽 ±0.780 을 13개가 8.2 mm 간극으로 메운다 (직경 121.8, 피치 130). -->
  <xacro:property name="drive_wheel_n"  value="13"/>      <!-- 측당 -->
  <xacro:property name="drive_wheel_x0" value="0.780"/>   <!-- 최외곽 |x| -->
  <xacro:property name="drive_wheel_dx" value="0.130"/>   <!-- 간격 = 직경 + 8.2 mm -->

  <!-- ⚠ **촘촘한 배치는 공짜가 아니다.** 접촉점이 16 → 26 개로 늘면서 실시간
       계수(RTF)가 실측 **0.35 → 0.22** 로 떨어졌다 (ship_block_drift, 헤드리스).
       시저 링키지가 다시 0.22 → 0.19 를 먹어서 전체로는 대략 **절반 속도**다.
       드리프트 실험처럼 긴 주행을 여러 번 돌릴 때는 시간이 두 배로 든다.

       속도가 급하면 여기 세 줄만 되돌리면 된다 (기구학·오도메트리는 안 바뀐다):
           drive_wheel_n 8 / drive_wheel_x0 0.77 / drive_wheel_dx 0.22
       시저만 끄려면 아래 body_sc_n, end_sc_n 을 0 으로 두면 된다 —
       링크와 제어기가 통째로 사라지고 상하축은 그대로 동작한다. -->

  <!-- ═══ 회전축 게인 — 반력으로 바퀴부가 돌아가는 것을 줄인다 ═══
       바퀴부에는 횡방향·요 구속이 없다 (바퀴가 폭 150 mm 플랜지에 얹혀만 있다).
       몸체부·전후단부를 돌리면 그 반력을 바퀴부가 마찰로만 받아내서 요가 돌아간다.

       도면에 없는 부품(가이드 롤러 등)을 더할 수는 없으므로 **토크를 줄여서**
       완화한다. 위치 제어기의 cmd_max 가 곧 최대 토크이고, 그게 반력의 크기다.
       천천히 돌리면 각가속도가 작아져 반력도 작아진다.

       ⚠ 이건 완화지 해결이 아니다. 요 오차는 회전 속도를 낮추는 만큼만 준다.
         구조적으로 없애려면 횡방향 구속이 필요하다 — 설계 확인 사항. -->
  <xacro:property name="turn_p"       value="2000"/>
  <xacro:property name="turn_i"       value="60"/>
  <xacro:property name="turn_d"       value="2500"/>
  <xacro:property name="turn_cmd_max" value="700"/>    <!-- N·m. 낮출수록 느리고 얌전 -->

  <!-- ⚠ 관절 마찰이 곧 **정상편차**가 된다: e = friction / turn_p.
       처음에 friction=50, P=2000 이라 0.025 rad(1.43도) 앞에서 멈춰버렸다
       (목표 1.5708 인데 1.546 에서 정지 — 허용오차 0.02 를 못 넘김).
       토크를 낮췄으니 마찰도 같이 낮춰야 도달한다. 15/2000 = 0.0075 rad.
       I 게인도 올려 남은 편차를 적분으로 밀어낸다. -->
  <xacro:property name="turn_damping"  value="300.0"/>
  <xacro:property name="turn_friction" value="15.0"/>

  <!-- ⚠ **gz 는 이 값을 강제하지 않는다.** 0.15 로 낮춰 두고 실제 각속도를 재 보니
       0.41 rad/s 로 돌았다. 회전을 진짜로 늦추려면 **지령을 램프**로 올려야 한다
       (patrol.py 참조). 여기 값은 문서용으로만 남긴다. -->
  <xacro:property name="turn_vel"      value="0.5"/>    <!-- rad/s (강제되지 않음) -->

  <!-- ═══ 덱을 붙드는 게인 — ⚠ 흔들림을 없애지 못한다, 옮길 뿐이다 ═══
       전후단부를 들어 돌리면 그 반력이 어딘가로 가야 하는데, 그때 로봇에는
       **요를 잡아 줄 외부 구속이 없다** (바퀴부는 폭 150 mm 플랜지에 얹혀만 있다).
       그래서 반력은 덱과 바퀴부가 게인 비율대로 나눠 갖는다.

       실측 (전후단부 −90° 회전 중, ship_block_cad_world):

           시도                            덱 편차   바퀴부 yaw
           그대로 (p 2000)                  7.7°      0.20°
           회전속도 4배 느리게               7.1°      0.75°
           지령 추종형 램프                  7.8°      0.16°
           한쪽씩 딛고 회전 (닿기만)          6.8°      0.99°
           한쪽씩 눌러 딛고 회전              8.1°      0.24°
           서로 반대 방향으로 회전            6.1°      0.67°
           덱 게인 d 10배 (25000)           5.7°      2.19°
           **덱 게인 p 10배 (20000)**       3.0°      5.01°  ← 바퀴부로 넘어감

       **속도로는 안 줄어든다.** 게인을 올리면 덱은 잡히지만 그만큼 바퀴부가 돌고,
       바퀴부 yaw 가 곧 항법 기준이라 그쪽이 더 나쁘다. 그래서 기본값은 예전 그대로다.
       구조적으로 없애려면 바퀴부에 **횡방향·요 구속**(가이드 롤러 등)이 필요하다 —
       도면에 없는 부품이라 여기서는 못 넣는다. 설계 확인 사항이다.

       덱만 잡고 싶고 바퀴부 yaw 를 감수하겠다면 body_turn_p 를 올리면 된다. -->
  <xacro:property name="body_turn_p"       value="2000"/>
  <xacro:property name="body_turn_i"       value="60"/>
  <xacro:property name="body_turn_d"       value="2500"/>
  <xacro:property name="body_turn_cmd_max" value="700"/>

  <!-- ═══ 끝단부 — 바닥 주행 ═══
       회전부(턴테이블) Ø400 이 회전축이고, 그 아래 무한궤도가 바닥에 닿는다. -->
  <!-- ═══ ⚠ 전후단부 회전축 간격 — 도면과 다르게 뒀다. 확인 필요 ═══
       **도면 실측은 ±1.5275 m** (회전부 Ø400 중심). 그런데 이 값으로는
       지시하신 회전 메커니즘이 성립하지 않는다.

       몸체부를 90° 돌리면 전후단부는 몸체부 중심에서 이 거리만큼 **론지를 가로지르는
       방향**으로 떨어진 곳에 온다. 그 자리가 통로여야 바닥에 내려앉을 수 있는데,
       통로는 론지 pitch(0.845) 간격으로만 있다. 즉 **이 값이 pitch 의 정수배여야
       한다.** 1.5275 는 2배(1.690)에서 163 mm 모자라, 전후단부(폭 543)가
       통로(695) 를 벗어나 론지에 걸터앉는다.

       실측 확인 (x=-1.97, y=-0.0325 스폰, maneuver.py 전 구간):
         end_turn_x = 1.5275 → 착지 후 z **0.9552** (로봇이 435 mm 들림) ✗
         end_turn_x = 1.690  → 착지 후 z **0.5200** (바퀴부가 론지 위 유지) ✓

       그래서 기본값을 1.690 으로 뒀다. 대신 로봇 길이가 4.100 → 4.426 m 가 된다.
       설계에 확인할 것:
         (a) 실제 회전축 간격이 pitch 정수배(1.690)인가?
         (b) 아니면 전후단부에 횡방향 조절이 따로 있는가?
         (c) 아니면 수직 자세에서는 론지 위에 앉는 게 정상인가?
              → 그렇다면 1.5275 로 되돌리고 maneuver.py 의 lift-down 옵션에 0.450 을 준다. -->
  <xacro:property name="end_turn_x"     value="1.690"/>   <!-- = 2 x longi_pitch -->
  <!-- <xacro:property name="end_turn_x"  value="1.5275"/>    도면 실측값 -->

  <xacro:property name="end_track_gauge" value="0.4660"/> <!-- 끝단 체인 중심 간격 -->
  <xacro:property name="end_track_width" value="0.0769"/>
  <xacro:property name="end_axle_z"     value="0.0629"/>
  <xacro:property name="end_wheel_radius" value="${end_axle_z}"/>
  <xacro:property name="end_wheel_x"    value="0.38"/>    <!-- 회전축에서 ±, 접지 롤러 -->
  <!-- 끝단부 전체 높이. 아래 상·하 분리 이후로는 end_upper_z1 이 같은 값을 갖는다.
       도면 치수 기록으로 남겨 둔다. -->
  <xacro:property name="end_unit_z1"    value="0.454"/>   <!-- 회전부 상면 -->

  <!-- ═══ 끝단부는 **한 덩어리가 아니다** ═══
       도면 서브어셈블리가 셋으로 갈라진다 (step_to_robot.py 실측, 로봇 z):

           윗부분(회전부 Ø400 + 상부 프레임)   0.384 ~ 0.454   길이 1.040
           시저 (NEWRVB240523200)              0.130 ~ 0.384   길이 1.002  ← 앞뒤로 꽉 참
           아랫부분(궤도)                       0.000 ~ 0.130   길이 1.050

       · **윗부분은 몸체부에 붙어 회전만 한다.** 내려가지 않는다.
       · **아랫부분만 시저로 바닥까지 내려간다.**
       그래서 URDF 축 순서가 회전 → 승강이다 (예전엔 승강 → 회전이었다).

       ⚠ 도면의 시저 형상은 **접힌 자세로 굳어 있어** 메시에서 뺐다.
         그대로 두면 아랫부분을 내렸을 때 늘어나지 않고 허공에 남는다.
         같은 자리에 파라메트릭 X자 바를 세워 대체한다. -->
  <xacro:property name="end_upper_z0"   value="0.384"/>   <!-- 윗부분 하면 = 시저 상단 -->
  <xacro:property name="end_upper_z1"   value="0.454"/>   <!-- 윗부분 상면 = 덱 하면 -->
  <xacro:property name="end_upper_x"    value="0.520"/>   <!-- ±, 윗부분 길이/2 -->
  <xacro:property name="end_upper_y"    value="0.240"/>   <!-- ± -->
  <xacro:property name="end_lower_z1"   value="0.130"/>   <!-- 아랫부분(궤도) 상면 -->
  <xacro:property name="end_lower_x"    value="0.525"/>   <!-- ± -->
  <xacro:property name="end_lower_y"    value="0.270"/>   <!-- ± -->

  <!-- **론지 상면 ↔ 바닥 낙차.** 끝단부는 이만큼 내려가야 바닥에 닿는다.
       블록 도면 실측: 론지 플랜지 상면 0.520, 바닥판 상면 0.070. -->
  <xacro:property name="end_drop"       value="0.450"/>
  <!-- ═══ ⚠ 블록 바닥에서 가장 높은 것은 론지가 아니라 **거더**다 ═══
       충돌 메시(STANDARD BLOCK ASSY)를 훑어보면 바닥 구조물이 두 종류다:

           론지 (플랜지 상면)            z 0.520   pitch 0.845 로 촘촘히
           거더 수평 보강대 (론지가 '빠진' 자리)
                                         z 0.590 (좌현 y -3.060) / 0.660 (우현 y +2.995)

       docs/robot.md 의 "론지 중심 목록에 -3.871~-2.145 와 2.080~3.845 가 비어 있다"는
       것은 론지가 빠진 게 아니라 **그 자리에 더 높은 거더가 있다**는 뜻이었다.
       거더는 론지 상면보다 **70 ~ 140 mm 더 높다.**

       ⚠ **전후단부를 돌릴 때 이 높이가 곧 필요 스트로크다.** 전후단부는 회전축에서
         반경 0.51 m(접지 롤러 스윕)를 쓰므로, 스윙 원이 거더에 걸리면 롤러가
         거더 상면을 긁는다. 그러면 회전축이 멈칫하면서 그 반력이 1.69 m 팔로
         덱을 비트는데, 이것이 **"전후단부를 돌리면 덱이 출렁인다"의 정체였다**
         (실측 6.8° / 8.2°, docs/robot.md 참조). 진동도 지지 형상 문제도 아니다. -->
  <xacro:property name="block_girder_top" value="0.660"/>   <!-- 블록 내부 최고 거더 보강대 상면 -->

  <!-- 상하 스트로크: q=0 이 **론지 주행 자세**(끝단부가 바닥). + 로 올린다.
       end_drop 만큼 올리면 도면의 '전부 한 평면' 자세가 된다 —
       즉 **전후단부 하면이 론지 상면과 같은 높이**이고 여유는 0 이다.

       ⚠ **도면 스트로크(450)로는 전후단부를 돌릴 수 없다.** 거더(0.660)를 넘으려면
         하면이 통로 바닥에서 0.590 위로 가야 하므로 여유 50 mm 를 더해 **640 mm**
         가 필요하다. 예전 값 0.500 은 론지(0.520)는 넘지만 거더는 못 넘었다.
         **설계 확인 사항이다** — end_turn_x 와 같은 성격의 항목.
         도면 시저는 접힘 254 mm 라 기구적 상한이 0.696 - 0.254 = 0.442 이므로,
         0.640 을 내려면 **시저 단수/바 길이를 키워야 한다.**
         지금 모델은 만행정에서 X자가 신장 59 mm / θ 1.69° 까지 납작해진다
         (q=0 에서는 696 mm / 20.4°). 종동 링키지라 물리적으로는 문제없지만,
         실제 시저가 그만큼 접히지 못한다는 것이 곧 위의 설계 확인 사항이다.
       ⚠ 상한은 end_sc_ext_hi(0.696)보다 작아야 한다 — 같아지면 시저가 뒤집힌다. -->
  <xacro:property name="end_lift_clear" value="${block_girder_top - 0.070 + 0.05}"/>  <!-- 0.640 -->
  <xacro:property name="end_lift_up"    value="${end_lift_clear + 0.02}"/>            <!-- 0.660 -->
  <!-- **음수 행정 = 잭업.** 전후단부가 통로 바닥에 닿은 상태에서 더 밀어내리면
       바닥이 막으니 반력으로 **로봇 전체가 뜬다** — 바퀴부가 론지에서 떨어진다.
       그래야 바퀴부를 론지와 수직으로 돌릴 수 있다 (횡단 주행의 전제).
       0.05 면 바퀴가 플랜지를 넘고, 0.08 까지 열어 여유를 둔다. -->
  <xacro:property name="end_lift_down"  value="0.080"/>

  <!-- ═══ 시저 리프트 (X자 팬터그래프) ═══
       상하축 두 곳(바퀴부↔몸체부, 몸체부↔전후단부)의 **실제 승강 기구**다.
       도면에는 리프트 기구가 링크 단위로 담겨 있지 않아 형상을 여기서 세운다.

       ⚠ **시저는 닫힌 루프라 URDF 로 직접 못 쓴다.** 그래서 이렇게 나눴다:
         · 하중과 행정은 지금까지대로 **prismatic 관절**(body_lift/front_lift/rear_lift)이
           그대로 담당한다 — 지령 단위(m)도, 제어 게인도, 측정 인터페이스도 안 바뀐다.
         · X자 바는 그 행정을 따라가는 **종동 링키지**다. 충돌체가 없고 하중을 받지
           않으며, `scissor_driver` 노드가 계산한 각도로 위치제어된다.

       ⚠ mimic 관절로 묶는 방법은 **쓸 수 없다.** dartsim 이 지원하지 않는다
         ("the chosen physics engine does not support mimic constraints").
         bullet-featherstone 은 지원하지만 엔진을 바꾸면 접촉·마찰 모델이 달라져
         이 저장소의 드리프트 측정이 통째로 무효가 된다.

       ━━ 기하 ━━
       바 길이 L, 단수 N, 바 각도 θ 일 때 스택 높이 = N·L·sinθ.
       그래서 필요한 신장량 ext 에서 **θ = asin(ext / (N·L))** 로 역산한다.
       바는 끝핀·중간핀으로 엮여서 관절값이 **θ 와 2θ 두 가지뿐**이다
       (crawler.urdf.xacro 의 scissor_stack 주석 참조) — 지령 토픽도 둘이면 된다. -->
  <!-- ⚠ **더 가볍게 하지 말 것.** 0.1 kg 으로 낮춰 봤더니 실시간 계수가
       0.15 → 0.11 로 떨어졌다 — 가벼운 링크에 위치제어가 걸리면 솔버가 더 힘들어진다.
       반력이 주행을 흔드는지도 확인했는데 오도메트리 오차가 0.00 mm 라 문제가 없었다.
       0.6 kg 이 검증된 값이다. 질량을 바꾸면 아래 게인도 같이 바꿔야 한다 (p ∝ I). -->
  <xacro:property name="scissor_bar_mass" value="0.6"/>    <!-- 종동체. 두께는 조립체별 -->

  <!-- 몸체부 시저 — **회전 프레임 상면(0.344) 과 덱 하면(0.454+q) 사이**.
       접힘 110 mm, 최대 260 mm → ext(q) = 0.110 + q.

       **바 길이는 전후단부와 같은 방식으로 바퀴부 길이(1.652 m)에 맞춘다.**
       전후단부가 유닛 1.05 m 에 바 1.0 m 였으니 여기는 1.55 m — 폭이 전 행정에서
       1.545~1.549 m 로 유지된다. 그래서 앞뒤 두 조가 아니라 **한 조**다
       (1.55 m 짜리를 두 개 놓으면 서로 겹친다).

       ⚠ 행정이 150 mm 뿐이라 X자가 **납작하다** (θ 2.0°~4.8°). 바를 길게 할수록
         더 납작해진다 — 같은 신장량을 긴 바로 내면 각도가 작아지기 때문이다.
         더 크게 벌어지게 하려면 바를 줄이거나 body_lift_range(0.15)를 키워야 한다.
         전후단부(θ 5.7°~20.4°)가 시원하게 접히는 건 행정이 500 mm 라서다. -->
  <xacro:property name="body_sc_n"    value="2"/>
  <xacro:property name="body_sc_len"  value="1.550"/>   <!-- 바퀴부 앞뒤 길이에 맞춤 -->
  <xacro:property name="body_sc_dy"   value="0.185"/>   <!-- 주 체인 바의 y 열 -->
  <xacro:property name="body_sc_dy2"  value="0.125"/>   <!-- 짝 바는 안쪽 열 (아래 ⚠) -->
  <xacro:property name="body_sc_ext0" value="0.110"/>   <!-- q=0 에서 접힌 높이 -->
  <xacro:property name="body_sc_x"    value="-0.775"/>  <!-- 고정핀 x -->
  <xacro:property name="body_sc_ty"   value="0.050"/>   <!-- 바 두께 (y) -->
  <xacro:property name="body_sc_tz"   value="0.045"/>   <!-- 바 두께 (z). 접힘 55 mm 보다 얇아야 -->

  <!-- 전후단부 시저 — **윗부분(회전부)에 매달려 아랫부분(궤도)을 내리는** 기구다.
       q=0(바닥)에서 최대로 펼쳐지고 들어올릴수록 접힌다.

       신장량은 도면에서 바로 나온다:
           접힘(도면 자세) = 윗부분 하면 0.384 − 아랫부분 상면 0.130 = 0.254
           최대            = 접힘 + 낙차 0.450 ≈ 0.696       → ext(q) = 0.696 − q

       **바 길이는 전후단부 앞뒤 길이(1.05 m)에 맞춘다** — 도면 시저도 1.002 m 로
       유닛에 꽉 차 있다. 긴 바 2단이면 전 행정에서 폭이 0.94~1.00 으로 유지된다.
       짧은 바를 여러 단 쌓으면 펼칠 때 폭이 확 줄어 유닛 안에서 가늘어진다.
       ⚠ ext_hi 는 end_lift_up(0.660) 보다 커야 한다. 같거나 작으면 만행정에서
         sinθ 가 음수가 되어 바가 뒤집힌다. -->
  <xacro:property name="end_sc_n"      value="2"/>
  <xacro:property name="end_sc_len"    value="1.000"/>   <!-- 유닛 앞뒤 길이에 맞춤 -->
  <xacro:property name="end_sc_dy"     value="0.190"/>   <!-- 주 체인 바의 y 열 -->
  <xacro:property name="end_sc_dy2"    value="0.135"/>   <!-- 짝 바는 안쪽 열 -->
  <xacro:property name="end_sc_ty"     value="0.040"/>   <!-- 큰 시저라 바도 굵다 -->
  <xacro:property name="end_sc_tz"     value="0.050"/>
  <xacro:property name="end_sc_ext_hi" value="0.696"/>   <!-- q=0 에서 펼친 높이 -->
  <xacro:property name="end_sc_x"      value="-0.483"/>  <!-- 고정핀 x (유닛 중앙 정렬) -->

  <!-- 종동 링키지 위치제어 게인. **조립체마다 다르다** — 바 길이가 4배 차이나면
       관성도 중력 모멘트도 그만큼 커져서 같은 게인으로는 안 잡힌다.

       튜닝 기준은 폐루프 대역 ω = √(p/I) 와 감쇠비 ζ = d / (2√(p·I)) 다.
       관절축 관성은 전후단부 바(1.0 m) 약 0.2, 몸체부 바(1.55 m) 약 0.48 이다
       (원통 자체 관성 + 무게중심이 핀에서 blen/2 떨어진 몫). p 를 관성에 비례해
       잡고 d 로 ζ≈0.65 를 맞춘다.
       ⚠ 바 길이를 바꾸면 **여기 게인도 같이 바꿔야 한다.** 바를 0.5 → 1.55 m 로
         키우고 게인을 그대로 뒀더니 추종 오차가 0.42° → 1.3° 로 커졌다 (실측).

       ⚠ **d 를 관성에 비해 크게 잡으면 관절이 목표 앞에서 멎는다.** 몸체부 바에
         d=60 을 걸었더니 최대 12도 못 미친 채 정지했다 (실측). 반대로 전후단부
         바에 d=2 를 쓰면 주 체인이 중력에 밀려 과열린다 (실측 +6도).
       ⚠ cmd_max 는 실제 필요 토크보다 넉넉해야 한다. 전후단부 주 체인은 아래
         체인 전체(2.4 kg, 팔 길이 1 m)를 드므로 70 N·m 안팎이 필요하다. -->
  <xacro:property name="sc_i"          value="0"/>
  <!-- 몸체부 시저 (바 1.55 m — 관절축 관성 약 0.48, 전후단부보다도 크다) -->
  <xacro:property name="sc_body_p"     value="16000"/>
  <xacro:property name="sc_body_d"     value="110"/>
  <xacro:property name="sc_body_cmd"   value="500"/>
  <!-- 전후단부 시저 (바 1.0 m) -->
  <xacro:property name="sc_end_p"      value="8000"/>
  <xacro:property name="sc_end_d"      value="52"/>
  <xacro:property name="sc_end_cmd"    value="400"/>

  <!-- ═══ 몸체부 (바퀴부 위, 상하·회전) ═══
       메시는 상판+레일이고, 리니어축·팔·전후단부가 전부 여기 매달린다. -->
  <xacro:property name="deck_x"         value="2.050"/>   <!-- ±X -->
  <xacro:property name="deck_y"         value="0.250"/>   <!-- ±Y -->
  <xacro:property name="deck_z0"        value="0.454"/>
  <xacro:property name="deck_z1"        value="0.486"/>   <!-- 레일 상면 -->
  <xacro:property name="body_lift_range" value="0.15"/>   <!-- 몸체부 상하 행정 -->

  <!-- ═══ 바퀴부 ↔ 몸체부 사이: 회전부 + 시저 ═══
       전후단부와 같은 구성이다 — **회전부가 바퀴부에 얹히고, 그 위에 시저**가
       몸체부를 들어올린다. 축 순서도 같다: 회전 → 승강.

       ⚠ **이 두 기구는 도면(6안)에 없다.** 도면에서 회전부(Ø400)는 양 끝단부
         (x ±1.5275)에만 있고, 바퀴부 상면(0.454)과 덱 하면(0.454)은 딱 붙어 있어
         사이에 아무것도 없다. 실제 기구에는 있다고 하여 파라메트릭으로 세운다.
         도면이 갱신되면 여기 치수를 실측으로 갈아끼울 것.

       ⚠ 사이 공간이 **0** 이므로 회전부(60)와 접힌 시저(60)는 바퀴부 상면 아래로
         120 mm 매립된다. 바퀴부 몸통이 z 0.029~0.454 라 그 안에 들어간다.
         q=0 에서는 안 보이고 들어올려야 드러난다 — 실제 매립형 리프트와 같다. -->
       ⚠ 시저를 바퀴부 길이(1.65 m)에 맞춰 키우면 **하단 핀이 x ±0.775 로 나간다.**
         턴테이블(Ø480, 반경 0.24)이 그걸 받을 수 없으므로 그 위에 **회전 프레임**
         (빔)을 얹고 시저 핀을 거기에 박는다. 프레임은 턴테이블과 한 몸이라
         /body_turn 을 돌리면 시저·덱과 함께 돈다.

         매립 깊이가 120 → 200 mm 로 깊어진다 (바퀴부 몸통 0.029~0.454 안):
             턴테이블      0.254 ~ 0.314   (60)
             회전 프레임    0.314 ~ 0.344   (30)
             시저(접힘)     0.344 ~ 0.454   (110)  → ext(q) = 0.110 + q -->
  <xacro:property name="body_turn_z1"   value="0.314"/>   <!-- 턴테이블 상면 -->
  <xacro:property name="body_turn_z0"   value="0.254"/>   <!-- 턴테이블 하면 -->
  <xacro:property name="body_turn_r"    value="0.240"/>   <!-- 턴테이블 반경 (Ø480) -->
  <xacro:property name="body_turn_mass" value="30.0"/>
  <!-- 회전 프레임 — 시저 하단 핀을 받는 빔. 턴테이블과 한 링크다. -->
  <xacro:property name="body_frame_z1"  value="0.344"/>   <!-- 프레임 상면 = 시저 하단 -->
  <xacro:property name="body_frame_x"   value="0.800"/>   <!-- ± -->
  <xacro:property name="body_frame_y"   value="0.180"/>   <!-- ± -->
  <xacro:property name="body_frame_mass" value="25.0"/>

  <!-- ═══ 리니어축 (THK HSR25) ═══
       레일 x −1.940 ~ +1.960 (3.900 m), 슬라이더 4개 span 0.400
       → 행정 3.500 m, 중심 x = +0.010 에서 ±1.750 -->
  <xacro:property name="rail_center_x"  value="0.010"/>
  <xacro:property name="rail_travel"    value="1.750"/>
  <xacro:property name="carriage_ref_x" value="1.760"/>   <!-- 도면 슬라이더 중심 = 메시 원점 -->
  <xacro:property name="carriage_box_x" value="0.502"/>
  <xacro:property name="carriage_box_y" value="0.440"/>
  <xacro:property name="carriage_ctr_x" value="1.796"/>
  <xacro:property name="carriage_z0"    value="0.469"/>
  <xacro:property name="carriage_z1"    value="0.676"/>

  <!-- ═══ 매니퓰레이터 — FANUC CRX-20iA/L ═══
       레일 위 캐리지에 실려 덱을 따라 왕복한다.

       도면의 팔 형상은 **쓰지 않는다.** `J2ARM_UNIT_LONG` / `J3ARM_UNIT` 은
       체적 6 L / 1.3 L 인데 바운딩박스가 4.6 x 2.2 x 3.1 m 라 링크가 아니라
       작동영역(또는 오배치)이고, 나머지도 접힌 자세로 굳은 덩어리라
       "레일을 따라 왔다갔다 하는 팔"을 표현하지 못한다.
       그래서 **제원으로 6축을 세웠다.**

       ⚠ **링크 길이는 공개 제원(도달 1418 mm)에서 역산한 근사다.**
         J2 부터 플랜지까지 0.710 + 0.540 + 0.168 = 1.418 로 맞췄다.
         FANUC 공식 치수도면이 들어오면 이 세 값을 갈아끼울 것.
         관절 한계는 CRX-20iA/L 공개 사양 그대로다. -->
  <xacro:property name="arm_mount_z"  value="0.676"/>   <!-- 캐리지 상면 = 팔 베이스 -->
  <xacro:property name="arm_base_h"   value="0.090"/>   <!-- 베이스 원통 높이 -->
  <xacro:property name="arm_base_r"   value="0.085"/>
  <xacro:property name="arm_sh_h"     value="0.140"/>   <!-- J1 위 숄더 하우징 -->
  <xacro:property name="arm_sh_r"     value="0.080"/>
  <xacro:property name="arm_sh_y"     value="0.090"/>   <!-- 숄더 옆으로 물리는 오프셋 -->
  <xacro:property name="arm_upper"    value="0.710"/>   <!-- J2 → J3 -->
  <xacro:property name="arm_fore"     value="0.540"/>   <!-- J3 → J5 -->
  <xacro:property name="arm_wrist"    value="0.168"/>   <!-- J5 → 플랜지 -->
  <xacro:property name="arm_link_r"   value="0.058"/>   <!-- 팔 원통 반경 -->

  <!-- 기본 자세 = **접은 자세**. 관절값 0 은 팔이 곧게 선 자세(도달 2.3 m)라
       주행 중에 쓸 수 없다. 제어기 initial_position 으로 접어 둔다. -->
  <!-- 상완을 수평으로 눕히고(J2 90°) 전완을 그 위로 되접는다(J3 -169°).
       실측 포락: z 0.906~1.052, x +0.010~+0.720 — 블록 내부(5.18 m)에 여유롭다. -->
  <xacro:property name="arm_home_j2"  value="1.5708"/>
  <xacro:property name="arm_home_j3"  value="-2.95"/>
  <xacro:property name="arm_home_j5"  value="0.0"/>

  <!-- 관절 한계 (CRX-20iA/L 공개 사양) -->
  <xacro:property name="arm_lim_j1"   value="3.1416"/>  <!-- ±180° -->
  <xacro:property name="arm_lim_j2"   value="3.1416"/>
  <xacro:property name="arm_lim_j3"   value="4.7124"/>  <!-- ±270° -->
  <xacro:property name="arm_lim_j4"   value="3.3161"/>  <!-- ±190° -->
  <xacro:property name="arm_lim_j5"   value="3.1416"/>
  <xacro:property name="arm_lim_j6"   value="3.9270"/>  <!-- ±225° -->

  <!-- 팔 링크에 충돌체를 달지 여부. 이 저장소의 목적(주행 드리프트)에는 팔이
       **캐리지 위 질량**으로만 관여하므로 꺼도 결과가 바뀌지 않는다.
       실측 이득은 작다 — 실시간 계수 0.15(켬) 대 0.17(끔). 물리적으로 옳은
       쪽을 기본으로 둔다. 분사 궤적을 길게 돌려 속도가 급하면 끌 것. -->
  <xacro:property name="arm_collision" value="true"/>

  <xacro:property name="arm_p"        value="4000"/>
  <xacro:property name="arm_i"        value="10"/>
  <xacro:property name="arm_d"        value="400"/>
  <xacro:property name="arm_cmd_max"  value="1500"/>

  <!-- ═══ 질량 ═══
       ⚠ 전부 가정치다. 도면에 재질 정보가 없어 CAD 체적으로만 추정했다.
         질량은 드리프트 자체보다 **가감속 응답·미끄러짐**에 영향을 준다. -->
  <xacro:property name="wheel_unit_mass" value="150.0"/>
  <!-- 끝단부 80 kg 을 상·하로 나눈다. 궤도·롤러가 있는 아랫부분이 무겁다.
       ⚠ 배분은 가정치다 (도면에 재질이 없다). 합은 예전 end_unit_mass 와 같게 뒀다. -->
  <xacro:property name="end_upper_mass"  value="25.0"/>
  <xacro:property name="end_lower_mass"  value="55.0"/>
  <xacro:property name="deck_mass"       value="60.0"/>
  <xacro:property name="carriage_mass"   value="30.0"/>
  <!-- 팔 100 kg 을 6축 링크로 나눈다 (CRX-20iA/L 본체 ~75 kg + 툴·케이블).
       ⚠ 배분은 가정치다. 합은 예전 arm_mass 와 같게 뒀다 — 주행 드리프트에는
         팔의 총질량과 무게중심 높이만 관여한다. -->
  <xacro:property name="arm_base_mass"  value="25.0"/>
  <xacro:property name="arm_sh_mass"    value="15.0"/>
  <xacro:property name="arm_upper_mass" value="25.0"/>
  <xacro:property name="arm_fore_mass"  value="18.0"/>
  <xacro:property name="arm_wrist_mass" value="12.0"/>
  <xacro:property name="arm_tool_mass"  value="5.0"/>
  <xacro:property name="wheel_mass"      value="3.0"/>

  <!-- ═══ 스폰 기준값 (런치 인자) ═══
       z : **론지 플랜지 상면** 0.520 + 여유 → base_footprint 기준
       y : **인접 론지 두 개의 중점** — 양쪽 바퀴가 각 론지에 걸쳐야 하므로.
           왼쪽(+Y) ← 4.2675 / 1.6575 / 0.8125 / -0.0325 / **-0.8775** / -1.7225 / -4.2935 → 오른쪽(-Y)
           (론지 중심은 -4.716 -3.871 -2.145 -1.300 -0.455 0.390 1.235 2.080 3.845 4.690)
           ⚠ 중심 간격이 균일하지 않다 — -3.871~-2.145 와 2.080~3.845 는 론지가
             하나씩 빠져 있어 그 사이는 걸터탈 수 없다. 위 목록만 유효하다.
           **현재 기본 스폰은 -0.8775** (론지 -1.300 과 -0.455 사이).
           한 칸 옮기려면 ±0.845(= 론지 pitch) 하되 위 목록 안에 있어야 한다.
       x : 횡프레임 안쪽 면이 −4.925 와 +0.985 (순간격 5.91 m) 인데 로봇이 4.43 m 라
           **주행 여유가 1.48 m 뿐**이다. 가운데서 시작하면 앞뒤로 쪼개지므로
           **뒤쪽(−X) 벽에 붙인 −2.68 을 기본**으로 한다 → 앞으로 1.45 m 연속 주행.
           실측: 후진시키면 x −2.697 에서 후단(x−2.2125 = −4.910)이 횡프레임에 닿는다.
           ⚠ 벽에 붙어 있으므로 maneuver.py 는 `-d 0.5`(앞으로) 로 줄 것. -->
  <xacro:property name="spawn_z_on_longi" value="0.53"/>

  <!-- ═══ 센서 장착 ═══ -->
  <!-- Livox Mid-360 (LiDAR + 내장 IMU).
       **바퀴부(base_link) 좌표 기준**이다. 몸체부가 아니다 — 몸체부는 /body_turn 으로
       회전하므로 거기 실으면 IMU 방위각이 주행체 방위각과 달라진다.
       바퀴부 중심 바로 위에 둔다. 회전 중심에서 멀수록 각가속도 성분이 가속도계에
       섞이므로(레버암 오차) 중심이 유리하다.
       ⚠ 도면에 센서가 없어 위치는 여전히 가정치다. 실제 장착 위치가 정해지면 교체할 것. -->
  <xacro:property name="imu_xyz" value="0.0 0.0 ${wheel_unit_z1 - 0.03}"/>
  <xacro:property name="imu_rpy" value="0.0 0.0 0.0"/>
  <xacro:property name="imu_rate" value="200"/>   <!-- Hz -->

  <!-- ═══ IMU 노이즈 모델 ═══
       ⚠ 이 값들이 실험 결과를 지배한다. 반드시 실측 Allan variance 로 교체할 것.
       아래는 소비자급 MEMS IMU 의 대략적인 값이며 낙관적일 수 있다.

       gz 의 <noise type="gaussian"> 파라미터 의미:
         stddev                        : white noise (각도/속도 random walk)
         bias_mean / bias_stddev       : 시행 시작 시 turn-on bias 샘플링
         dynamic_bias_stddev           : bias instability (Gauss-Markov σ)
         dynamic_bias_correlation_time : 그 상관시간 [s]

       Allan variance 에서 뽑는 대응:
         N (angle/velocity random walk) → stddev = N * sqrt(rate)
         B (bias instability)           → dynamic_bias_stddev
         T (correlation time)           → dynamic_bias_correlation_time
  -->
  <!-- 자이로 [rad/s] -->
  <xacro:property name="gyro_noise_stddev"      value="0.0003"/>
  <xacro:property name="gyro_bias_mean"         value="0.0000075"/>
  <xacro:property name="gyro_bias_stddev"       value="0.0008"/>
  <xacro:property name="gyro_dyn_bias_stddev"   value="0.00002"/>
  <xacro:property name="gyro_dyn_bias_tau"      value="400.0"/>
  <!-- 가속도계 [m/s^2] -->
  <xacro:property name="accel_noise_stddev"     value="0.0017"/>
  <xacro:property name="accel_bias_mean"        value="0.1"/>
  <xacro:property name="accel_bias_stddev"      value="0.001"/>
  <xacro:property name="accel_dyn_bias_stddev"  value="0.001"/>
  <xacro:property name="accel_dyn_bias_tau"     value="300.0"/>

  <!-- ═══ 오도메트리 ═══ -->
  <xacro:property name="odom_rate" value="50"/>   <!-- Hz -->

</robot>
