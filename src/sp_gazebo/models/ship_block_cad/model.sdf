<?xml version="1.0" ?>
<!--
  자동 생성 — 직접 수정하지 말 것.
  생성: sp_gazebo/scripts/step_to_gazebo.py
  원본: STANDARD BLOCK ASSY.stp

  스케일 0.001 적용 (원본 단위 추정: mm), 원점 모드: floor-center
  실제 크기: 10.03 x 10.00 x 5.18 m
-->
<sdf version="1.10">
  <model name="ship_block_cad">
    <static>true</static>
    <link name="body">
      <visual name="visual">
        <geometry>
          <mesh><uri>model://ship_block_cad/meshes/visual.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.40 0.42 0.45 1</ambient>
          <diffuse>0.48 0.50 0.53 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh><uri>model://ship_block_cad/meshes/collision.stl</uri></mesh>
        </geometry>
        <surface>
          <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
