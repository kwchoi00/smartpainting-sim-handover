# ── ROS2 / colcon ──
build/
install/
log/
.colcon*

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/

# ── 시크릿 ──
.env
.env.*
*.key
*.pem

# ── 대용량 산출물 (rosbag·영상은 리포 밖에서 관리) ──
*.bag
*.db3
*.mcap
*.mp4
*.webm
*.zip
*.7z

# ── STEP 도면에서 생성한 메시 ──
# 원본 STEP 은 cad/ 에 있다. 메시(블록 models/ship_block_cad/meshes/, 로봇
# sp_description/meshes/)는 clone 해서 바로 쓰도록 **커밋한다.**
# 도면이 바뀌면 step_to_gazebo.py / step_to_robot.py 로 다시 뽑아 커밋할 것.

# ── 실험 결과 (필요한 것만 골라 커밋) ──
# 'results/' 로 쓰면 디렉터리 자체가 제외돼 아래 negation 이 먹지 않는다.
results/*
!results/.gitkeep

# ── OS / 편집기 ──
.DS_Store
Thumbs.db
desktop.ini
*.user
.vscode/

# 로봇 STEP 파싱이 13분 걸려서 형상을 캐시한다 (step_to_robot.py)
.step_cache/
